# MCP-Hub 環境変数設定例
# このファイルを .env にコピーして編集してください

# データディレクトリ（設定ファイル + DB の保存先）
#   hub.config.json → {dir}/hub.config.json
#   hub.db         → {dir}/hub.db
# デフォルト: ./data
MCP_HUB_DATA_DIR=./data

# HTTP リスンポート (デフォルト: 26263)
# MCP_HUB_PORT=26263

# バインドアドレス (デフォルト: 0.0.0.0)
# MCP_HUB_HOST=0.0.0.0

# DBをクリアして hub.config.json から再シード (移行用)
# MCP_HUB_RESEED=1

# ログ出力形式: text (デフォルト) | json
# MCP_HUB_LOG=text

# 管理 API 認証キー (未設定時は認証なし)
# MCP_HUB_API_KEY=

# サーバー接続の最大リトライ回数 (デフォルト: 3)
# MCP_HUB_RETRY_MAX=3

# リトライ間隔のベース delay（秒、指数バックオフ。デフォルト: 1.0)
# MCP_HUB_RETRY_DELAY=1.0

# 同時ツール呼び出しの最大数 (デフォルト: 50)
# MCP_HUB_MAX_CONCURRENT_CALLS=50

# ツール呼び出しのタイムアウト（秒。デフォルト: 30)
# MCP_HUB_CALL_TOOL_TIMEOUT=30

# list_tools 集約のタイムアウト（秒。デフォルト: 10.0)
# MCP_HUB_LIST_TOOLS_TIMEOUT=10.0

# list_tools() リトライ時の遅延（秒。デフォルト: 0.3)
# MCP_HUB_LIST_TOOLS_RETRY_DELAY=0.3

# アップストリームへのリクエスト読み取りタイムアウト（秒。デフォルト: 180.0)
# MCP_HUB_CLIENT_TIMEOUT=180.0

# 起動時の接続確認 list_tools() のタイムアウト（秒。デフォルト: 30.0)
# MCP_HUB_CONNECT_TIMEOUT=30.0

# ヘルスチェックの間隔（秒。デフォルト: 60)
# MCP_HUB_HEALTH_INTERVAL=60

# ヘルスチェックのタイムアウト（秒。デフォルト: 25)
# MCP_HUB_HEALTH_TIMEOUT=25

# ヘルスチェックの連続失敗許容回数 (デフォルト: 3)
# MCP_HUB_HEALTH_MAX_FAILURES=3

# 死んだサーバーへの自動再接続試行の最小間隔（秒。デフォルト: 300.0)
# MCP_HUB_RECOVERY_COOLDOWN=300.0

# アップストリームセッションのアイドル有効期限（秒。未設定時は SDK 既定=期限なしを維持）
# MCP_HUB_SESSION_IDLE_TIMEOUT=

# セマンティック検索の強制無効化 (0 でハードキル。デフォルト: 1)
# MCP_HUB_EMBEDDING=1
